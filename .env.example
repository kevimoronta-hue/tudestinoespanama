# ── Site ────────────────────────────────────────────────────────────────
# Production domain — NOT CONFIRMED YET. Leave empty until the client provides it.
# While empty: no canonical/hreflang/sitemap URLs are emitted and robots blocks indexing.
NEXT_PUBLIC_SITE_URL=

# Show content marked status:"demo" (always labelled "Demo").
# Default: shown in `next dev`, hidden in production builds. Never enable on the public site.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=

# ── Contact form delivery (server-only, never exposed to the client) ─────
# Without an endpoint the API answers 503 and the form shows an error (no fake success).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Optional routing per request type:
CONTACT_WEBHOOK_URL_CONOCER=
CONTACT_WEBHOOK_URL_VIVIR=
CONTACT_WEBHOOK_URL_INVERTIR=
CONTACT_WEBHOOK_URL_EMPRESA=
CONTACT_WEBHOOK_URL_OTRA=
# Development only: validate without sending; the UI says explicitly that nothing was sent.
CONTACT_DRY_RUN=

# Debug: log analytics events to the console in development.
NEXT_PUBLIC_DEBUG_ANALYTICS=
